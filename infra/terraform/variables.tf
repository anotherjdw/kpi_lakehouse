# variables.tf -- generated by pipeline-automator scaffold (project init)
# Project-wide input variables for the kpi_lakehouse data pipeline.

variable "aws_region" {
  description = "AWS region into which the kpi_lakehouse pipeline resources are deployed."
  type        = string
  default     = "eu-central-1"
}

variable "environment" {
  description = "Deployment environment (e.g. dev, staging, prod)."
  type        = string
  default     = "prod"
}

variable "data_product" {
  description = "Name of the data product this pipeline belongs to."
  type        = string
  default     = "kpi_lakehouse"
}

variable "bucket_names" {
  description = "Suffixes for the four medallion and scripts S3 buckets. Combined with '<data_product>-<environment>-', lower-cased with '_' turned into '-' (local.bucket_prefix), to form the full bucket name."
  type        = map(string)
  default = {
    raw          = "raw"
    preprocessed = "preprocessed"
    processed    = "processed"
    scripts      = "scripts"
  }
}

variable "lifecycle_rules_enabled" {
  description = "Whether to enable intelligent-tiering and noncurrent version expiration on all S3 buckets."
  type        = bool
  default     = true
}

variable "noncurrent_version_expiration_days" {
  description = "Days after which noncurrent S3 object versions are expired."
  type        = number
  default     = 90
}

variable "tags" {
  description = "Common tags applied to all resources."
  type        = map(string)
  default = {
    DataProduct = "kpi_lakehouse"
    Project     = "kpi_lakehouse"
    Environment = "prod"
    ManagedBy   = "terraform"
  }
}
