# modules/iam/main.tf -- generated by pipeline-automator scaffold (project init)
# Execution role assumed by Glue jobs in this data product.
# Permissions follow least-privilege per medallion layer:
#   raw        → read-only (source of truth, never written by ETL)
#   preprocessed, processed → read-write (ETL output layers)
#   scripts    → read-only (Glue fetches its own script at job startup),
#                plus write under temp/ (the jobs' --TempDir, for shuffle and spill)

locals {
  common_tags = merge(var.tags, {
    Environment = var.environment
    ManagedBy   = "terraform"
  })
}

data "aws_iam_policy_document" "glue_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["glue.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "glue_execution" {
  name               = "${var.name_prefix}-glue-execution"
  assume_role_policy = data.aws_iam_policy_document.glue_assume.json
  tags               = local.common_tags
}

resource "aws_iam_role_policy_attachment" "glue_service" {
  role       = aws_iam_role.glue_execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSGlueServiceRole"
}

data "aws_iam_policy_document" "s3_access" {
  statement {
    sid     = "RawReadOnly"
    effect  = "Allow"
    actions = ["s3:GetObject", "s3:ListBucket"]
    resources = [
      var.raw_bucket_arn,
      "${var.raw_bucket_arn}/*",
    ]
  }

  statement {
    sid    = "PreprocessedProcessedReadWrite"
    effect = "Allow"
    actions = [
      "s3:GetObject",
      "s3:PutObject",
      "s3:DeleteObject",
      "s3:ListBucket",
    ]
    resources = [
      var.preprocessed_bucket_arn,
      "${var.preprocessed_bucket_arn}/*",
      var.processed_bucket_arn,
      "${var.processed_bucket_arn}/*",
    ]
  }

  statement {
    sid     = "ScriptsReadOnly"
    effect  = "Allow"
    actions = ["s3:GetObject", "s3:ListBucket"]
    resources = [
      var.scripts_bucket_arn,
      "${var.scripts_bucket_arn}/*",
    ]
  }

  statement {
    sid       = "ScriptsTempWrite"
    effect    = "Allow"
    actions   = ["s3:PutObject", "s3:DeleteObject"]
    resources = ["${var.scripts_bucket_arn}/temp/*"]
  }
}

resource "aws_iam_policy" "s3_access" {
  name   = "${var.name_prefix}-glue-s3-policy"
  policy = data.aws_iam_policy_document.s3_access.json
  tags   = local.common_tags
}

resource "aws_iam_role_policy_attachment" "s3_access" {
  role       = aws_iam_role.glue_execution.name
  policy_arn = aws_iam_policy.s3_access.arn
}

#-------------------------
# Alerts
#-------------------------

data "aws_iam_policy_document" "glue_alerts" {
  statement {
    sid       = "AlertTopicPublish"
    effect    = "Allow"
    actions   = ["sns:Publish"]
    resources = [var.alert_topic_arn]
  }

  # A job reads its own run's state and timeout, to report a stop or a timeout itself.
  statement {
    sid       = "OwnJobRunRead"
    effect    = "Allow"
    actions   = ["glue:GetJobRun"]
    resources = ["arn:aws:glue:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:job/${var.name_prefix}-*"]
  }
}

resource "aws_iam_role_policy" "glue_alerts" {
  name   = "glue-alerts"
  role   = aws_iam_role.glue_execution.id
  policy = data.aws_iam_policy_document.glue_alerts.json
}

#-------------------------
# Extraction IAM role
#--------------------------

data "aws_region" "current" {}
data "aws_caller_identity" "current" {}

data "aws_iam_policy_document" "lambda_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      identifiers = ["lambda.amazonaws.com"]
      type        = "Service"
    }
  }
}

resource "aws_iam_role" "extract" {
  name               = "${var.name_prefix}-shop-sim-extract"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
  tags               = local.common_tags
}

data "aws_iam_policy_document" "extract" {
  statement {
    actions = ["rds-db:connect"]
    resources = [
      "arn:aws:rds-db:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:dbuser:${var.db_cluster_resource_id}/${var.db_user}"
    ]
  }
  statement {
    actions   = ["s3:PutObject"]
    resources = ["arn:aws:s3:::${var.raw_data_bucket}/*"]
  }
}

resource "aws_iam_role_policy" "extract" {
  name   = "shop-sim-extract"
  role   = aws_iam_role.extract.id
  policy = data.aws_iam_policy_document.extract.json
}

resource "aws_iam_role_policy_attachment" "extract_lambda_basic" {
  role       = aws_iam_role.extract.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy_attachment" "extract_vpc" {
  role       = aws_iam_role.extract.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
}

# ---------------
# Daily Schedule
# ---------------

data "aws_iam_policy_document" "scheduler_assume_role" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["scheduler.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "extract_scheduler" {
  name               = "${var.name_prefix}-shop-sim-extract-scheduler"
  assume_role_policy = data.aws_iam_policy_document.scheduler_assume_role.json
  tags               = local.common_tags
}

data "aws_iam_policy_document" "extract_scheduler_invoke" {
  statement {
    actions   = ["lambda:InvokeFunction"]
    resources = ["arn:aws:lambda:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:function:shop-sim-extract"]
  }
}

resource "aws_iam_role_policy" "extract_scheduler_invoke" {
  name   = "shop-sim-extract-invoke"
  role   = aws_iam_role.extract_scheduler.id
  policy = data.aws_iam_policy_document.extract_scheduler_invoke.json
}
