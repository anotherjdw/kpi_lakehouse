# Environment configuration for the kpi_lakehouse pipeline.
# Copy to .env and fill in real values. .env is gitignored.

# --- AWS ------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_PROFILE=
ENVIRONMENT=prod

# --- Data product ---------------------------------------------------------
DATA_PRODUCT=kpi_lakehouse
DATA_BUCKET=

# --- Spark (local development) --------------------------------------------
SPARK_MASTER=local[*]
